<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_estate" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.estate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Properties" name="estate_properties">
                    <field name="property_ids" readonly="True" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>